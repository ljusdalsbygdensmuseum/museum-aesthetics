{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "maes/container",
	"version": "0.1.0",
	"title": "Styled container",
	"category": "design",
	"icon": "tablet",
	"description": "A styled and animated container",
	"attributes": {
		"backgrounds": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object",
				"properties": {
					"border": {
						"type": "object",
						"properties": {
							"top": {
								"type": "object",
								"properties": {
									"width": {
										"type": "string"
									},
									"color": {
										"type": "string"
									},
									"style": {
										"type": "string"
									}
								}
							},
							"bottom": {
								"type": "object",
								"properties": {
									"width": {
										"type": "string"
									},
									"color": {
										"type": "string"
									},
									"style": {
										"type": "string"
									}
								}
							},
							"left": {
								"type": "object",
								"properties": {
									"width": {
										"type": "string"
									},
									"color": {
										"type": "string"
									},
									"style": {
										"type": "string"
									}
								}
							},
							"right": {
								"type": "object",
								"properties": {
									"width": {
										"type": "string"
									},
									"color": {
										"type": "string"
									},
									"style": {
										"type": "string"
									}
								}
							}
						}
					},
					"offset": {
						"type": "object",
						"properties": {
							"top": {
								"type": "string"
							},
							"bottom": {
								"type": "string"
							},
							"left": {
								"type": "string"
							},
							"right": {
								"type": "string"
							}
						}
					},
					"fade": {
						"type": "object",
						"properties": {
							"horizontal": {
								"type": "object",
								"properties": {
									"toggle": {
										"type": "boolean",
										"default": false
									},
									"width": {
										"type": "number"
									}
								}
							},
							"vertical": {
								"type": "object",
								"properties": {
									"toggle": {
										"type": "boolean",
										"default": false
									},
									"width": {
										"type": "number"
									}
								}
							}
						}
					},
					"shadow": {
						"type": "object",
						"properties": {
							"toggle": {
								"type": "boolean"
							},
							"horizontal": {
								"type": "string"
							},
							"vertical": {
								"type": "string"
							},
							"size": {
								"type": "string"
							},
							"color": {
								"type": "string"
							}
						}
					},
					"fullWidth": {
						"type": "boolean"
					},
					"rotation": {
						"type": "number"
					},
					"opacity": {
						"type": "number"
					},
					"gradientBackground": {
						"type": "boolean"
					},
					"background": {
						"type": "string"
					}
				}
			}
		}
	},
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "maes-domain",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
