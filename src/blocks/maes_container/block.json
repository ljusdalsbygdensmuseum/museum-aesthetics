{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "maes/container",
	"version": "0.1.0",
	"title": "Styled container",
	"category": "design",
	"icon": "tablet",
	"description": "A styled and animated container",
	"attributes": {
		"border": {
			"type": "object",
			"properties": {
				"top": {
					"type": "object",
					"properties": {
						"border": {
							"type": "object",
							"properties": {
								"width": {
									"type": "string"
								},
								"color": {
									"type": "string"
								},
								"style": {
									"type": "string"
								}
							}
						},
						"offset": {
							"type": "string"
						}
					}
				},
				"bottom": {
					"type": "object",
					"properties": {
						"border": {
							"type": "object",
							"properties": {
								"width": {
									"type": "string"
								},
								"color": {
									"type": "string"
								},
								"style": {
									"type": "string"
								}
							}
						},
						"offset": {
							"type": "string"
						}
					}
				},
				"left": {
					"type": "object",
					"properties": {
						"border": {
							"type": "object",
							"properties": {
								"width": {
									"type": "string"
								},
								"color": {
									"type": "string"
								},
								"style": {
									"type": "string"
								}
							}
						},
						"offset": {
							"type": "string"
						}
					}
				},
				"right": {
					"type": "object",
					"properties": {
						"border": {
							"type": "object",
							"properties": {
								"width": {
									"type": "string"
								},
								"color": {
									"type": "string"
								},
								"style": {
									"type": "string"
								}
							}
						},
						"offset": {
							"type": "string"
						}
					}
				}
			},
			"default": {
				"top": {
					"border": {
						"width": null,
						"color": null,
						"style": null
					},
					"offset": null
				},
				"bottom": {
					"border": {
						"width": null,
						"color": null,
						"style": null
					},
					"offset": null
				},
				"left": {
					"border": {
						"width": null,
						"color": null,
						"style": null
					},
					"offset": null
				},
				"right": {
					"border": {
						"width": null,
						"color": null,
						"style": null
					},
					"offset": null
				}
			}
		},
		"fade": {
			"type": "object",
			"properties": {
				"horizontal": {
					"type": "object",
					"properties": {
						"toggle": {
							"type": "boolean",
							"default": false
						},
						"width": {
							"type": "number"
						}
					}
				},
				"vertical": {
					"type": "object",
					"properties": {
						"toggle": {
							"type": "boolean",
							"default": false
						},
						"width": {
							"type": "number"
						}
					}
				}
			},
			"default": {
				"horizontal": {
					"toggle": false,
					"width": 15
				},
				"vertical": {
					"toggle": false,
					"width": 15
				}
			}
		},
		"fullWidth": {
			"type": "boolean",
			"default": false
		},
		"opacity": {
			"type": "number",
			"default": 100
		},
		"gradientBackground": {
			"type": "boolean",
			"default": false
		},
		"background": {
			"type": "string",
			"default": ""
		}
	},
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "maes-domain",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
