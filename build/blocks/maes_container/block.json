{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "maes/container",
  "version": "0.1.0",
  "title": "Styled container",
  "category": "design",
  "icon": "tablet",
  "description": "A styled and animated container",
  "attributes": {
    "border": {
      "type": "object",
      "properties": {
        "top": {
          "type": "object",
          "properties": {
            "toggled": {
              "type": "boolean",
              "default": false
            },
            "width": {
              "type": "number"
            },
            "offset": {
              "type": "number"
            },
            "color": {
              "type": "string"
            },
            "opacity": {
              "type": "number"
            }
          }
        },
        "bottom": {
          "type": "object",
          "properties": {
            "toggled": {
              "type": "boolean",
              "default": false
            },
            "width": {
              "type": "number"
            },
            "offset": {
              "type": "number"
            },
            "color": {
              "type": "string"
            },
            "opacity": {
              "type": "number"
            }
          }
        },
        "left": {
          "type": "object",
          "properties": {
            "toggled": {
              "type": "boolean",
              "default": false
            },
            "width": {
              "type": "number"
            },
            "offset": {
              "type": "number"
            },
            "color": {
              "type": "string"
            },
            "opacity": {
              "type": "number"
            }
          }
        },
        "right": {
          "type": "object",
          "properties": {
            "toggled": {
              "type": "boolean",
              "default": false
            },
            "width": {
              "type": "number"
            },
            "offset": {
              "type": "number"
            },
            "color": {
              "type": "string"
            },
            "opacity": {
              "type": "number"
            }
          }
        }
      },
      "default": {
        "top": {
          "toggled": false,
          "width": 2,
          "offset": 0,
          "color": "#fff",
          "opacity": 1
        },
        "bottom": {
          "toggled": false,
          "width": 2,
          "offset": 0,
          "color": "#fff",
          "opacity": 1
        },
        "left": {
          "toggled": false,
          "width": 2,
          "offset": 0,
          "color": "#fff",
          "opacity": 1
        },
        "right": {
          "toggled": false,
          "width": 2,
          "offset": 0,
          "color": "#fff",
          "opacity": 1
        }
      }
    }
  },
  "example": {},
  "supports": {
    "html": false
  },
  "textdomain": "maes-domain",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}